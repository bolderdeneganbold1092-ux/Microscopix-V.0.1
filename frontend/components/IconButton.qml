import QtQuick
import QtQuick.Controls

// Square pixel button. The name appears while the pointer is on it.
Button {
    id: btn
    property string mark: "draw"
    property string tip: ""
    property bool tipBelow: false
    property bool active: false
    property real zoom: 2
    hoverEnabled: true

    readonly property color ink: active ? "#ffffff" : "#000000"

    background: Item {
        Rectangle { x: 2; y: 2; width: parent.width - 2; height: parent.height - 2; color: "#000000" }
        Rectangle {
            x: btn.down ? 2 : 0
            y: btn.down ? 2 : 0
            width: parent.width - 2
            height: parent.height - 2
            color: btn.active ? "#3d7dff" : "#f4f4f4"
            border.width: 2
            border.color: "#000000"
        }
    }

    contentItem: Item {
        Item {
            width: btn.span * btn.zoom
            height: btn.span * btn.zoom
            anchors.centerIn: parent
            anchors.horizontalCenterOffset: btn.down ? 2 : 0
            anchors.verticalCenterOffset: btn.down ? 2 : 0
            Item {
                width: btn.span
                height: btn.span
                scale: btn.zoom
                transformOrigin: Item.TopLeft
                layer.enabled: true
                layer.smooth: false
                layer.mipmap: false
                Repeater {
                    model: btn.cells
                    delegate: Rectangle {
                        required property var modelData
                        x: modelData.x
                        y: modelData.y
                        width: 1
                        height: 1
                        color: btn.ink
                    }
                }
            }
        }
    }

    readonly property int span: {
        var rows = grids[mark]
        return rows && rows.length ? rows[0].length : 16
    }
