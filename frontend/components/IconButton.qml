    readonly property var cells: {
        var rows = grids[mark] || []
        var out = []
        for (var y = 0; y < rows.length; y++) {
            var row = rows[y]
            for (var x = 0; x < row.length; x++) {
                if (row[x] === "#")
                    out.push({x: x, y: y})
            }
        }
        return out
    }

    ToolTip {
        id: nameTip
        visible: btn.hovered && tip !== ""
        text: btn.tip
        delay: 0
        timeout: 60000
        x: (btn.width - width) / 2
        y: btn.tipBelow ? btn.height + 8 : -height - 8
        padding: 8
        topPadding: 6
        bottomPadding: 6
        contentItem: PixelText {
            text: nameTip.text
            color: "#000000"
            pixel: 5
        }
        background: Rectangle {
            color: "#f4f4f4"
            border.width: 2
            border.color: "#000000"
        }
    }
